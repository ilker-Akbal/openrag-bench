{
  "version": 1,
  "rules": [
    {
      "id": "overall-quality",
      "select": {
        "type": "all"
      },
      "metric": "ndcg_at_k",
      "min_delta": 0
    },
    {
      "id": "critical-coverage",
      "select": {
        "type": "critical"
      },
      "metric": "hit_at_k",
      "min_query_score": 1,
      "max_regressed_queries": 0
    },
    {
      "id": "privacy-category",
      "select": {
        "type": "category",
        "value": "privacy"
      },
      "metric": "recall_at_k",
      "min_score": 1
    }
  ]
}
